{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intranet-ppt:deck:1",
  "title": "Intranet PPT deck configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "blue",
        "emerald",
        "crimson",
        "mono",
        "graphite"
      ],
      "default": "blue",
      "description": "Optional theme palette. Canonical spec-palette hexes inside component HTML are remapped to the theme colors during library loading."
    },
    "master": {
      "$ref": "#/$defs/localPath"
    },
    "libraries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localPath"
      }
    },
    "pageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 100,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 100,
          "maximum": 10000
        }
      }
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "If supplied must equal pages.length; CLI enforces this relationship."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "masterSlide": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "elements": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "$ref": "#/$defs/element"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 1,
      "description": "Relative local file within the configuration directory. No URLs, UNC, absolute paths, traversal or symlink escape."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "underline": {
          "type": "boolean"
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "richtext": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/runs"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs"
          ],
          "properties": {
            "runs": {
              "$ref": "#/$defs/runs"
            }
          }
        }
      ]
    },
    "listItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/richtext"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Nesting level; omitted means level 1."
            },
            "text": {
              "$ref": "#/$defs/richtext"
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "underline": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "image": {
      "anyOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "$ref": "#/$defs/localPath"
            },
            "alt": {
              "type": "string"
            }
          }
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/richtext"
        }
      }
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/richtext"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/rows"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "$ref": "#/$defs/rows"
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}/[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "box": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/input"
          },
          "description": "Names and types must match the selected component catalog."
        }
      }
    }
  }
}
