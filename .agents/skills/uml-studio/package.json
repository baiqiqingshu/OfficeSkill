{
  "name": "@office/uml-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/core.mjs",
  "types": "./dist/types/src/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./vue": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/vue.mjs"
    },
    "./node": {"types":"./dist/types/src/native.d.ts","import":"./dist/native.mjs"},
    "./style.css": "./dist/diagram.css"
  },
  "scripts": {
    "demo:refresh": "node scripts/gallery.mjs",
    "demo:verify": "node scripts/verify-demo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.17.1",
    "elkjs": "^0.10.0",
    "parse5": "^8.0.1",
    "sharp": "^0.35.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.0"
  }
}
