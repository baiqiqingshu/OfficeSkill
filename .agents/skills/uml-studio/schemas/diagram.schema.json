{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://office-skill.local/uml-studio/diagram.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_\\-:.]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "activity",
        "sequence",
        "swimlane",
        "flowchart",
        "usecase",
        "class",
        "state",
        "component",
        "package",
        "architecture",
        "module",
        "deployment",
        "logical",
        "development",
        "process",
        "physical",
        "scenario",
        "fishbone"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "modern",
        "ocean",
        "white",
        "industrial",
        "paper",
        "forest",
        "blueprint",
        "midnight",
        "lavender",
        "rose",
        "amber",
        "slate",
        "mint",
        "vivid",
        "pastel",
        "business",
        "steel",
        "aurora",
        "neon"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "surface": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "text": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "muted": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "primary": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "border": {
          "type": "string",
          "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<>;{}\\\\]+$"
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 48
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "fontStyle": {
          "type": "string",
          "enum": [
            "normal",
            "italic"
          ]
        },
        "textDecoration": {
          "type": "string",
          "enum": [
            "none",
            "underline"
          ]
        },
        "lineWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "nodeWidth": {
          "type": "number",
          "minimum": 80,
          "maximum": 600
        },
        "nodeHeight": {
          "type": "number",
          "minimum": 32,
          "maximum": 300
        },
        "gap": {
          "type": "number",
          "minimum": 24,
          "maximum": 240
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
          },
          "minItems": 1,
          "maxItems": 16,
          "description": "多色调色板；元素颜色按 paletteBy 轮换。"
        },
        "paletteMode": {
          "type": "string",
          "enum": [
            "mono",
            "tint",
            "solid",
            "gradient"
          ],
          "description": "mono 单色；tint 浅色填充彩色描边；solid 实色填充；gradient 渐变填充。"
        },
        "paletteBy": {
          "type": "string",
          "enum": [
            "auto",
            "group",
            "kind",
            "node"
          ],
          "description": "auto：有分组/泳道按分组，否则按节点顺序。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "compact",
            "balanced",
            "spacious",
            "grid"
          ],
          "default": "balanced"
        },
        "edgeCrossing": {
          "type": "string",
          "enum": [
            "bridge",
            "plain"
          ],
          "default": "bridge",
          "description": "节点图连线交叉表示：bridge 为拱桥形跳线，plain 为无圆点直接交叉；两者都表示不相连。"
        },
        "horizontalStagger": {
          "type": "boolean",
          "default": false,
          "description": "流程、活动、泳道图中，跨列相连元素沿流程方向错开；false 保持水平对齐优先。"
        },
        "adjustments": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_./:-]+$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "dx": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "dy": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "dx",
                      "dy"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "edges": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_./:-]+$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "waypoints": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        },
                        "y": {
                          "type": "number",
                          "minimum": -1000000,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "waypoints"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "showTitle": {
          "type": "boolean",
          "default": false
        },
        "maxWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "maxHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "regionGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "elementGap": {
          "type": "number",
          "minimum": 8,
          "maximum": 400
        },
        "maxPerColumn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "nodeMaxWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "nodeMaxHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "autonumber": {
          "type": "boolean",
          "default": true,
          "description": "时序图消息编号；Mermaid 导入默认关闭。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "direction": {
      "type": "string",
      "enum": [
        "TB",
        "LR"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "action",
              "decision",
              "start",
              "end",
              "fork",
              "join",
              "actor",
              "usecase",
              "class",
              "interface",
              "component",
              "package",
              "database",
              "server",
              "queue",
              "state",
              "note",
              "terminal",
              "subroutine",
              "io",
              "hexagon",
              "circle",
              "trapezoid"
            ]
          },
          "detail": {
            "type": "string"
          },
          "stereotype": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "lane": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "style": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "surface": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "text": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "muted": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "primary": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "secondary": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "border": {
                "type": "string",
                "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
              },
              "fontFamily": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^<>;{}\\\\]+$"
              },
              "fontSize": {
                "type": "number",
                "minimum": 8,
                "maximum": 48
              },
              "fontWeight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "fontStyle": {
                "type": "string",
                "enum": [
                  "normal",
                  "italic"
                ]
              },
              "textDecoration": {
                "type": "string",
                "enum": [
                  "none",
                  "underline"
                ]
              },
              "lineWidth": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 8
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 32
              },
              "nodeWidth": {
                "type": "number",
                "minimum": 80,
                "maximum": 600
              },
              "nodeHeight": {
                "type": "number",
                "minimum": 32,
                "maximum": 300
              },
              "gap": {
                "type": "number",
                "minimum": 24,
                "maximum": 240
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
                },
                "minItems": 1,
                "maxItems": 16,
                "description": "多色调色板；元素颜色按 paletteBy 轮换。"
              },
              "paletteMode": {
                "type": "string",
                "enum": [
                  "mono",
                  "tint",
                  "solid",
                  "gradient"
                ],
                "description": "mono 单色；tint 浅色填充彩色描边；solid 实色填充；gradient 渐变填充。"
              },
              "paletteBy": {
                "type": "string",
                "enum": [
                  "auto",
                  "group",
                  "kind",
                  "node"
                ],
                "description": "auto：有分组/泳道按分组，否则按节点顺序。"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flow",
              "association",
              "dependency",
              "include",
              "extend",
              "inheritance",
              "realization",
              "aggregation",
              "composition"
            ]
          },
          "dashed": {
            "type": "boolean"
          },
          "fromLabel": {
            "type": "string"
          },
          "toLabel": {
            "type": "string"
          },
          "arrow": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "open",
              "triangle",
              "circle",
              "cross"
            ]
          },
          "startArrow": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "open",
              "triangle",
              "circle",
              "cross"
            ]
          },
          "thick": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "boundary",
              "package",
              "node"
            ]
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "actor",
              "participant",
              "database",
              "boundary",
              "control",
              "entity",
              "collections",
              "queue"
            ]
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_\\-:.]+$"
            },
            "minItems": 1
          },
          "color": {
            "type": "string",
            "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
          }
        },
        "required": [
          "label",
          "participants"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-:.]+$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sync",
              "async",
              "return",
              "create",
              "destroy",
              "note",
              "divider"
            ]
          },
          "activate": {
            "type": "boolean"
          },
          "deactivate": {
            "type": "boolean"
          },
          "arrow": {
            "type": "string",
            "enum": [
              "filled",
              "open",
              "none",
              "cross"
            ]
          },
          "dashed": {
            "type": "boolean"
          },
          "bidirectional": {
            "type": "boolean"
          },
          "position": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "over"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "alt",
              "opt",
              "loop",
              "par",
              "critical",
              "break",
              "rect"
            ]
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "elseAt": {
            "type": "integer",
            "minimum": 0
          },
          "elseLabel": {
            "type": "string"
          },
          "elses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "at"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "color": {
            "type": "string",
            "pattern": "^(transparent|#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?)$"
          }
        },
        "required": [
          "kind",
          "label",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "fishbone": {
      "type": "object",
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "headStyle": {
          "type": "string",
          "enum": [
            "classic",
            "fish",
            "slim",
            "shark",
            "roundfish",
            "carp",
            "sunfish",
            "triangle",
            "rounded",
            "label"
          ],
          "default": "classic",
          "description": "默认保留原版鱼头与比例；其余轮廓仅在显式选择时应用，不改变原因结构。"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_\\-:.]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "causes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/cause"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "label",
              "causes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "effect",
        "categories"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "type",
    "title"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "required": [
          "participants",
          "messages"
        ],
        "properties": {
          "participants": {
            "minItems": 1
          },
          "messages": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "fishbone"
          }
        }
      },
      "then": {
        "required": [
          "fishbone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "sequence",
                "fishbone"
              ]
            }
          }
        }
