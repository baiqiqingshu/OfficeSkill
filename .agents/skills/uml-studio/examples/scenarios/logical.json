{
  "version":1, "id":"commerce-logical", "type":"logical", "title":"4+1 逻辑视图 · 聚合与领域端口", "theme":"paper", "direction":"LR",
  "description":"逻辑视图表达业务对象、所有权和领域约束；与同册开发、进程、物理、场景视图使用相同业务域，但不重复同一结构。",
  "nodes":[
    {"id":"customer","label":"客户","kind":"class","attributes":["+ customerId: UUID","+ email: string"]},
    {"id":"order","label":"订单聚合","kind":"class","attributes":["+ orderId: UUID","+ status: OrderStatus"],"operations":["+ submit()","+ cancel()"]},
    {"id":"line","label":"订单明细","kind":"class","attributes":["+ sku: string","+ quantity: number"]},
    {"id":"money","label":"金额","kind":"class","stereotype":"value object","attributes":["+ amount: Decimal","+ currency: Currency"]},
    {"id":"payment","label":"支付单","kind":"class","attributes":["+ paymentId: UUID","+ state: PaymentState"]},
    {"id":"stock","label":"库存端口","kind":"interface","operations":["+ reserve(sku, quantity)"]},
    {"id":"shipment","label":"配送单","kind":"class","attributes":["+ trackingNumber: string"]},
    {"id":"rule","label":"约束：仅已支付订单可发货","kind":"note"}
  ],
  "edges":[
    {"from":"customer","to":"order","kind":"association","fromLabel":"1","toLabel":"0..*"},
    {"from":"order","to":"line","kind":"composition","fromLabel":"1","toLabel":"1..*"},
    {"from":"line","to":"money","kind":"composition"},{"from":"order","to":"payment","kind":"association","fromLabel":"1","toLabel":"0..1"},
    {"from":"order","to":"stock","kind":"dependency","label":"预留库存"},
    {"from":"order","to":"shipment","kind":"association","fromLabel":"1","toLabel":"0..*"},
    {"from":"rule","to":"shipment","kind":"dependency","dashed":true}
  ]
}
