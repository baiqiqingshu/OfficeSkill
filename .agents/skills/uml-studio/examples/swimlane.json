    },
    {
      "id": "review",
      "label": "验收标准评审",
      "lane": "product"
    },
    {
      "id": "design",
      "label": "技术方案设计",
      "lane": "engineering"
    },
    {
      "id": "implement",
      "label": "实现与单元测试",
      "lane": "engineering"
    },
    {
      "id": "test",
      "label": "集成验证",
      "lane": "quality"
    },
    {
      "id": "accept",
      "label": "业务验收",
