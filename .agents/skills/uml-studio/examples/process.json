{
  "version": 1,
  "type": "process",
  "title": "4+1 · 进程视图",
  "description": "面向运行时：同步请求与异步工作进程通过消息队列解耦。",
  "theme": "paper",
  "direction": "LR",
  "nodes": [
    {
      "id": "client",
      "label": "客户端请求",
      "kind": "actor"
    },
    {
      "id": "api",
      "label": "API 进程池",
      "kind": "server",
      "detail": "同步处理 / 无状态"
    },
    {
      "id": "db",
      "label": "事务数据库",
      "kind": "database",
      "detail": "订单与 Outbox"
    },
    {
      "id": "relay",
      "label": "Outbox Relay",
      "kind": "component",
      "detail": "事件投递进程"
    },
    {
      "id": "queue",
      "label": "订单事件队列",
      "kind": "queue"
    },
    {
      "id": "worker",
      "label": "履约 Worker",
      "kind": "server",
      "detail": "并发消费者"
    },
    {
      "id": "notify",
      "label": "通知 Worker",
      "kind": "server",
      "detail": "邮件 / 短信"
    }
  ],
  "edges": [
    {
      "from": "client",
      "to": "api",
      "label": "下单请求"
    },
    {
      "from": "api",
      "to": "db",
      "label": "提交事务"
    },
    {
      "from": "db",
      "to": "relay",
      "label": "读取待发事件"
    },
    {
      "from": "relay",
      "to": "queue",
      "label": "OrderPlaced",
      "dashed": true
    },
    {
      "from": "queue",
      "to": "worker",
      "label": "消费",
      "dashed": true
    },
    {
      "from": "queue",
      "to": "notify",
      "label": "订阅",
      "dashed": true
    }
  ]
}
