      "label": "支付规则",
      "kind": "component",
      "detail": "金额 / 风控 / 幂等"
    },
    {
      "id": "port",
      "label": "渠道接口",
      "kind": "interface"
    },
    {
      "id": "bank",
      "label": "银行渠道",
      "kind": "component"
    },
    {
      "id": "wallet",
      "label": "钱包渠道",
      "kind": "component"
    }
  ],
  "edges": [
