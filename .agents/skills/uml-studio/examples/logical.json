{
  "version": 1,
  "type": "logical",
  "title": "4+1 · 逻辑视图",
  "description": "面向业务分析：订单、库存与支付领域的核心职责和协作。",
  "theme": "ocean",
  "direction": "LR",
  "nodes": [
    {
      "id": "customer",
      "label": "客户",
      "kind": "class",
      "attributes": [
        "+ customerId: UUID",
        "+ name: string"
      ]
    },
    {
      "id": "order",
      "label": "订单聚合",
      "kind": "class",
      "attributes": [
        "+ orderId: UUID",
        "+ status: OrderStatus"
      ],
      "operations": [
        "+ submit()",
        "+ cancel()"
      ]
    },
    {
      "id": "line",
      "label": "订单明细",
      "kind": "class",
      "attributes": [
        "+ sku: string",
        "+ quantity: number"
      ]
    },
    {
      "id": "stock",
      "label": "库存端口",
      "kind": "interface",
      "operations": [
        "+ reserve(sku, quantity)"
      ]
    },
    {
      "id": "payment",
      "label": "支付单",
      "kind": "class",
      "attributes": [
        "+ paymentId: UUID",
        "+ amount: Money"
      ]
    }
  ],
  "edges": [
    {
      "from": "customer",
      "to": "order",
      "kind": "association",
      "fromLabel": "1",
      "toLabel": "0..*"
    },
    {
      "from": "order",
      "to": "line",
      "kind": "composition",
      "fromLabel": "1",
      "toLabel": "1..*"
    },
    {
      "from": "order",
      "to": "stock",
      "kind": "dependency",
      "label": "预留库存"
    },
    {
      "from": "order",
      "to": "payment",
      "kind": "association",
      "fromLabel": "1",
      "toLabel": "0..1"
    }
  ]
}
