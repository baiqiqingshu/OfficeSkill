{
  "version": 1,
  "type": "scenario",
  "title": "4+1 · 场景视图",
  "description": "以“读者成功下单”为关键场景，串联业务需求与各架构视图。",
  "theme": "paper",
  "direction": "LR",
  "groups": [
    {
      "id": "system",
      "label": "书店系统",
      "kind": "boundary"
    }
  ],
  "nodes": [
    {
      "id": "reader",
      "label": "读者",
      "kind": "actor"
    },
    {
      "id": "browse",
      "label": "1 · 浏览并选书",
      "kind": "usecase",
      "group": "system"
    },
    {
      "id": "order",
      "label": "2 · 提交订单",
      "kind": "usecase",
      "group": "system"
    },
    {
      "id": "reserve",
      "label": "3 · 预留库存",
      "kind": "usecase",
      "group": "system"
    },
    {
      "id": "pay",
      "label": "4 · 完成支付",
      "kind": "usecase",
      "group": "system"
    },
    {
      "id": "notify",
      "label": "5 · 确认并通知",
      "kind": "usecase",
      "group": "system"
    },
    {
      "id": "bank",
      "label": "支付渠道",
      "kind": "actor"
    }
  ],
  "edges": [
    {
      "from": "reader",
      "to": "browse",
      "kind": "association"
    },
    {
      "from": "browse",
      "to": "order",
      "label": "确认购物车"
    },
    {
      "from": "order",
      "to": "reserve",
      "kind": "include"
    },
    {
      "from": "order",
      "to": "pay",
      "kind": "include"
    },
    {
      "from": "bank",
      "to": "pay",
      "kind": "association"
    },
    {
      "from": "pay",
      "to": "notify",
      "label": "支付成功"
    }
  ]
