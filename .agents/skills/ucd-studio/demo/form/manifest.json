    "action": "新建草稿",
    "eyebrow": "",
    "layout": "form",
    "style": "ocean",
    "density": "compact",
    "audience": "资源申请人",
    "goal": "填写并校验资源申请",
    "primaryTask": "填写并校验资源申请",
    "successCriteria": [
      "主任务和下一步操作清晰",
      "键盘可操作，窄屏保留主要内容"
    ],
    "assumptions": [
      "公司内网桌面端为主要场景；示例字段与流程需业务确认"
