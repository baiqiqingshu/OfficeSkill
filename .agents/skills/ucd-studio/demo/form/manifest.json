    "blocks": {
      "application": {
        "type": "form",
        "title": "填写申请信息",
        "description": "带 * 的项目为必填项。",
        "fields": [
          {
            "label": "申请名称",
            "required": true,
            "placeholder": "例如：研发环境资源申请"
          },
          {
            "label": "申请类型",
            "type": "select",
            "options": [
              "资源申请",
              "权限申请",
              "采购申请"
            ]
          },
          {
            "label": "联系邮箱",
            "type": "email",
            "required": true,
            "placeholder": "name@example.internal"
          },
          {
            "label": "期望完成日期",
            "type": "date",
            "required": true
          },
          {
            "label": "申请说明",
            "type": "textarea",
            "required": true,
            "placeholder": "说明使用场景、预期目标和资源需求",
            "help": "简要说明用途、资源规格和使用周期。"
          }
        ],
        "submit": "校验申请"
      },
      "context": {
        "type": "detail",
        "title": "填写说明",
        "items": [
          {
            "label": "适用范围",
            "value": "公司内部开发、测试与演示环境"
          },
          {
            "label": "申请准备",
            "value": "确认资源规格、用途和预计使用时间"
          },
          {
            "label": "后续流程",
            "value": "部门审批 → 资源配置 → 结果通知"
          },
          {
            "label": "当前状态",
            "value": {
              "text": "尚未提交",
              "tone": "neutral"
            }
          }
        ]
      },
      "faq": {
        "type": "accordion",
        "title": "常见问题",
        "span": "full",
        "items": [
          {
            "title": "申请提交后如何跟踪进度？",
            "content": "在事项列表中查看状态与处理记录。本原型展示示例流程，不连接真实审批服务。"
          },
          {
            "title": "信息填写错误时如何处理？",
            "content": "提交前可直接修改；真实业务中的撤回和重新提交规则需业务方确认。"
          }
        ]
      }
    }
